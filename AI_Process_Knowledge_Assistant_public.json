    {
      "parameters": {
        "jsCode": "const docs = [\n  {\n    id: \"automation-guidelines\",\n    title: \"Automation Guidelines\",\n    tags: [\"automation\", \"manual\", \"repetitive\", \"workflow\", \"ticket\"],\n    content: `\nRepetitive and rule-based tasks are strong candidates for automation.\nCustomer-facing automations should initially include human review.\nLow-confidence AI decisions should be escalated to a human.\nAutomations should have clear logging and error-handling mechanisms.\n    `.trim()\n  },\n\n  {\n    id: \"approved-tools\",\n    title: \"Approved Tools\",\n    tags: [\"jira\", \"n8n\", \"workflow\", \"integration\", \"automation\"],\n    content: `\nJira is the approved platform for work and task tracking.\nn8n is approved for workflow orchestration and API integrations.\nExternal AI services may only be used with non-sensitive test data during prototyping.\n    `.trim()\n  },\n\n  {\n  id: \"jira-label-guidelines\",\n  title: \"Jira Label Guidelines\",\n  tags: [\"jira\", \"labels\", \"metadata\", \"task\", \"automation\"],\n  content: `\nApproved Jira labels:\n\nDepartment:\n- customer-support\n- sales\n- finance\n- hr\n- it-operations\n- qa\n- front-end\n- back-end\n\nWork type:\n- ai-automation\n- process-improvement\n- knowledge-management\n\nStage:\n- discovery\n- pilot\n- production\n\nUse only labels from this approved list.\nChoose labels that reflect the department, work type, and current stage.\n  `.trim()\n},\n\n  {\n    id: \"support-process\",\n    title: \"Customer Support Process\",\n    tags: [\"support\", \"ticket\", \"customer\", \"queue\", \"triage\"],\n    content: `\nIncoming support tickets are currently reviewed manually.\nAgents classify tickets and assign them to the appropriate support queue.\nIncorrect routing can increase response times.\nCustomer Support owns the ticket-routing process.\n    `.trim()\n  },\n\n  {\n    id: \"previous-automation\",\n    title: \"Previous Automation Examples\",\n    tags: [\"ticket\", \"classification\", \"ai\", \"support\", \"confidence\"],\n    content: `\nA previous pilot used AI to classify incoming support requests.\nHigh-confidence classifications were routed automatically.\nLow-confidence classifications were sent to employees for review.\nThe pilot reduced manual triage effort while retaining human oversight.\n    `.trim()\n  }\n];\n\nreturn docs.map(doc => ({\n  json: doc\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        -64
      ],
      "id": "f043a2d5-b9c7-44bf-b66a-d5c28ba832d2",
      "name": "Mock Internal Knowledge base"
    },
    {
      "parameters": {
        "jsCode": "const request = $('Normalize Input').first().json;\n\nconst query = `\n${request.title}\n${request.description}\n${request.department}\n`.toLowerCase();\n\nconst docs = $input.all().map(item => item.json);\n\nconst scoredDocs = docs.map(doc => {\n  const score = doc.tags.reduce((total, tag) => {\n    return total + (query.includes(tag.toLowerCase()) ? 1 : 0);\n  }, 0);\n\n  return {\n    ...doc,\n    score\n  };\n});\n\nconst relevantDocs = scoredDocs\n  .filter(doc => doc.score > 0)\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 3);\n\nconst jiraLabelPolicy = {\n  department: [\n    \"customer-support\",\n    \"sales\",\n    \"finance\",\n    \"hr\",\n    \"it-operations\"\n  ],\n  work_type: [\n    \"ai-automation\",\n    \"process-improvement\",\n    \"knowledge-management\"\n  ],\n  stage: [\n    \"discovery\",\n    \"pilot\",\n    \"production\"\n  ]\n};\n\nreturn [\n  {\n    json: {\n      request,\n      retrieved_knowledge: relevantDocs,\n      jira_label_policy: jiraLabelPolicy\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        736,
        -64
      ],
      "id": "ee5827a3-9344-40a0-a189-9140ec515f72",
      "name": "Keyword Knowledge Retrieval"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"recommendation\": {\n      \"type\": \"string\"\n    },\n    \"implementation_approach\": {\n      \"type\": \"string\"\n    },\n    \"risk_level\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Low\",\n        \"Medium\",\n        \"High\"\n      ]\n    },\n    \"needs_human_review\": {\n      \"type\": \"boolean\"\n    },\n    \"human_review_reason\": {\n      \"type\": \"string\"\n    },\n    \"jira_labels\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    },\n    \"referenced_documents\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"maxItems\": 3\n    }\n  },\n  \"required\": [\n    \"recommendation\",\n    \"implementation_approach\",\n    \"risk_level\",\n    \"needs_human_review\",\n    \"human_review_reason\",\n    \"jira_labels\",\n    \"referenced_documents\"\n  ],\n  \"additionalProperties\": false\n}"
      },
